# Questo file serve per standardizzare le regole di git su questo progetto evitando che alcune regole globali dell'utente possano interferire con il flusso di lavoro.
# Viene installato automaticamente da `mise run setup` e non dovrebbe essere modificato.


[core]
    # Evidenzia spazi vuoti inutili a fine riga o a fine file
    whitespace = trailing-space,space-before-tab
    # Hooks del progetto (.github/hooks): pre-push blocca il push diretto su main, pre-commit blocca i commit non formattati
    hooksPath = .github/hooks
    # Compatibilità con Windows: disabilita CRLF automatico, forza LF e ignora i cambi dei permessi di esecuzione
    autocrlf = false
    eol = lf
    filemode = false

[pull]
    # Impedisce rebase involontari con `git pull`; con merge.ff = only il pull riesce solo se è un fast-forward.
    rebase = false

[push]
    # Crea automaticamente il branch remoto associato al primo push
    autoSetupRemote = true
    # Previene push accidentali su altri branch; spinge solo il branch corrente
    default = current

[merge]
    # Ammette solo merge fast-forward: se non è possibile, il merge fallisce.
    ff = only

[fetch]
    # Pulisce i riferimenti ai branch remoti che sono stati eliminati dal server
    prune = true

[alias]
    # Trova tutti i branch etichettati come [gone] e li cancella in un colpo solo
    sweep = "!f() { case \"$(uname -s)\" in MINGW*|CYGWIN*|MSYS*) powershell -NoProfile -Command \"git fetch --prune; git branch -vv | Select-String ': gone]' | ForEach-Object { git branch -D (\\$_.ToString().Trim() -split '\\s+')[0] }\" ;; *) git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -D ;; esac }; f"
