# This file standardizes the git rules for this project, so that the user's global rules cannot interfere with the workflow.
# It is installed automatically by `mise run setup` and should not be modified.


[core]
    # Highlight useless whitespace at end of line or end of file
    whitespace = trailing-space,space-before-tab
    # Project hooks (.github/hooks): pre-push blocks direct pushes to main, pre-commit blocks unformatted commits
    hooksPath = .github/hooks
    # Windows compatibility: disable automatic CRLF, force LF and ignore executable permission changes
    autocrlf = false
    eol = lf
    filemode = false

[pull]
    # Prevent accidental rebases with `git pull`; with merge.ff = only the pull succeeds only if it is a fast-forward.
    rebase = false

[push]
    # Automatically create the associated remote branch on the first push
    autoSetupRemote = true
    # Prevent accidental pushes to other branches; push only the current branch
    default = current

[merge]
    # Allow only fast-forward merges: if not possible, the merge fails.
    ff = only

[fetch]
    # Clean up references to remote branches deleted on the server
    prune = true

[alias]
    # Find all branches marked as [gone] and delete them in one go
    sweep = "!f() { case \"$(uname -s)\" in MINGW*|CYGWIN*|MSYS*) powershell -NoProfile -Command \"git fetch --prune; git branch -vv | Select-String ': gone]' | ForEach-Object { git branch -D (\\$_.ToString().Trim() -split '\\s+')[0] }\" ;; *) git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -D ;; esac }; f"
