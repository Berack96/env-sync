#!/bin/bash

# Block direct pushes to main: GitHub does not enforce branch protection
# on private repos without a paid plan.

while read local_ref local_sha remote_ref remote_sha
do
  if [[ "$remote_ref" == *"refs/heads/main" ]]; then
    echo "🛑 ERROR: direct push to 'main' blocked by the local hook."
    exit 1
  fi
done
exit 0
